# Copy this file to .env and fill in real values. .env is gitignored.

# Flask session signing key — required for the uid to survive between
# GET / (?uid=...) and POST /upload. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=changeme

# Shared secret for server-to-server API callers (sent as the X-API-Key
# header) — an alternative to the browser session for the auth-gated
# endpoints, and optional on POST /upload (supply a "uid" form field
# alongside it for upload-log attribution). Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
API_KEY=changeme

# MySQL connection for PII_redation_upload_log
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# Review timer on the results screen: seconds without mouse/keyboard input
# before it pauses. The idle stretch is excluded from review time and logged
# as idle_seconds in pii_process_review_time.
REVIEW_IDLE_SECONDS=15

# Ollama-compatible /api/chat endpoint for the SLM pass (Gemma model).
# Defaults to a local Ollama instance if unset.
GEMMA_API_URL=http://localhost:11434/api/chat
GEMMA_MODEL=gemma3:4b

# Agate Merger — the review page's "Next" button pushes the process's redacted
# files to Agate (POST /api/intake) and opens it in a new tab with them already
# in its upload list. Local testing: http://localhost:5015
AGATE_MERGER_URL=http://172.16.29.31:5015
# Shared secret sent as X-Agate-Intake-Key; must equal Agate's AGATE_INTAKE_API_KEY.
#   python -c "import secrets; print(secrets.token_hex(32))"
AGATE_INTAKE_API_KEY=changeme
