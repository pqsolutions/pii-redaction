        <mxCell id="c9" value="get_redaction_map_for_process(process_id)
→ {token: {value: [file_ids]}}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;fontStyle=0;dashed=0;arcSize=8;" vertex="1" parent="1"><mxGeometry x="400" y="600" width="300" height="60" as="geometry" /></mxCell>
        <mxCell id="c10" value="Scan the upload for every
