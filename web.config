<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <system.webServer>

        <!--
            IIS ARR Reverse Proxy → Waitress on port 5000.

            Prerequisites (install once, then run setup_iis.ps1):
              1. IIS URL Rewrite  – https://www.iis.net/downloads/microsoft/url-rewrite
              2. IIS ARR 3.0      – https://www.iis.net/downloads/microsoft/application-request-routing
        -->

        <!-- Enable ARR proxy at site level -->
        <proxy enabled="true"
               httpVersion="Http11"
               includePortInRequestURL="false"
               reverseRewriteHostInResponseHeaders="false"
               responseBufferLimit="0" />

        <rewrite>
            <rules>
                <clear />
                <rule name="PII Redaction Pipeline" stopProcessing="true">
                    <match url="(.*)" />
                    <action type="Rewrite" url="http://127.0.0.1:5009/{R:1}" />
                </rule>
            </rules>
        </rewrite>

        <!-- Allow large file uploads — must match app.py MAX_CONTENT_LENGTH (200 MB) -->
        <security>
            <requestFiltering>
                <requestLimits maxAllowedContentLength="209715200" />
            </requestFiltering>
        </security>

        <!-- Disable dynamic compression for SSE streams so they flush through immediately -->
        <httpCompression>
            <dynamicTypes>
                <remove mimeType="text/event-stream" />
                <add mimeType="text/event-stream" enabled="false" />
            </dynamicTypes>
        </httpCompression>

        <httpProtocol>
            <customHeaders>
                <remove name="X-Powered-By" />
            </customHeaders>
        </httpProtocol>

    </system.webServer>
</configuration>
